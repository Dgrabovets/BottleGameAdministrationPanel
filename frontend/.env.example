# Public API base URL (includes /api suffix). Used by the browser only for documentation.
# Runtime API calls go through the secure server proxy at /api/backend.
NEXT_PUBLIC_API_URL=https://api.bottledevadmin.ru/api

# Server-side backend URL for auth login and API proxy (not exposed to the browser).
INTERNAL_API_URL=https://api.bottledevadmin.ru/api

# Local development only: optional rewrite target (see next.config.mjs /dev-api).
# DEV_API_REWRITE_TARGET=https://127.0.0.1:6001
