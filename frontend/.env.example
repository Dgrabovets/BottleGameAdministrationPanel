# Public API base URL (includes /api suffix). Copy to .env.local for local development.
# Until api.bottledevadmin.ru DNS is configured, use admin host with /api proxy:
NEXT_PUBLIC_API_URL=https://admin.bottledevadmin.ru/api

# After api.bottledevadmin.ru points to the server:
# NEXT_PUBLIC_API_URL=https://api.bottledevadmin.ru/api
