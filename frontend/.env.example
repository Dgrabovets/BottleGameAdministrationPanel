# API base URL used by the Next.js server for login and the API proxy (includes /api).
# Never exposed to the browser. Matches the Docker setup of Bottle Game API.
INTERNAL_API_URL=http://localhost:8080/api

# Public API base URL, used only when INTERNAL_API_URL is empty.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Optional: rewrite target for a local API with a self-signed certificate (see next.config.mjs /dev-api).
# DEV_API_REWRITE_TARGET=https://127.0.0.1:6001
